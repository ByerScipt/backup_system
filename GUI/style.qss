QWidget {
    color: #253c53;
}
QMainWindow, QWidget#appRoot, QWidget#pageContent {
    background: #f4f9fe;
}
QScrollArea#pageScroll { background: transparent; border: none; }
QFrame#navigationRail {
    background: #eaf4ff;
    border-right: 1px solid #cddfed;
}
QLabel#brand { font-weight: 600; }
QLabel#hint { color: #57728b; }
QPushButton#navButton {
    text-align: left;
    background: transparent;
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 0 16px;
    min-height: 48px;
}
QPushButton#navButton:hover { background: #deedfb; }
QPushButton#navButton:checked {
    color: #1b5b96;
    background: #d9ebfc;
    border-color: #83b3dc;
}
QFrame#card {
    background: #ffffff;
    border: 1px solid #d2e2ef;
    border-radius: 8px;
}
QLineEdit, QComboBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #bfd5e7;
    border-radius: 6px;
    min-height: 46px;
}
QLineEdit, QSpinBox { padding: 0 14px; }
QComboBox {
    padding: 0 40px 0 14px;
    combobox-popup: 0;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 36px;
    border: none;
}
QComboBox::down-arrow {
    image: url(:/arrow_down.xpm);
    width: 12px;
    height: 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #428ace;
}
QLineEdit:disabled, QComboBox:disabled {
    background: #f1f6fa;
    color: #74899c;
}
QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #bfd5e7;
    selection-background-color: #d9ebfc;
    selection-color: #184d7e;
    padding: 0 12px;
}
QComboBox QAbstractItemView::item { padding: 8px 14px; }
QPushButton {
    background: #ffffff;
    border: 1px solid #bfd5e7;
    border-radius: 6px;
    min-height: 46px;
    padding: 0 12px;
}
QPushButton:hover { background: #edf6ff; border-color: #83b3dc; }
QPushButton:pressed { background: #dcecfb; }
QPushButton:focus { border-color: #428ace; }
QPushButton#primaryButton {
    background: #286fbd;
    border-color: #286fbd;
    color: #ffffff;
}
QPushButton#primaryButton:hover { background: #1e5fa5; }
QPushButton#dangerButton { color: #b54545; }
QPushButton#quietButton, QPushButton#toggleLog {
    border-color: transparent;
    background: transparent;
}
QPushButton#toggleLog:checked { color: #1b5b96; background: #d9ebfc; }
QPushButton:disabled, QPushButton#primaryButton:disabled,
QPushButton#dangerButton:disabled {
    color: #74899c;
    background: #f1f6fa;
    border-color: #d9e5ee;
}
QCheckBox { spacing: 8px; min-height: 36px; }
QProgressBar {
    border: 1px solid #d2e2ef;
    border-radius: 6px;
    background: #edf5fc;
    min-height: 30px;
    text-align: center;
}
QProgressBar::chunk { background: #b9dafa; }
QTextEdit, QTableWidget {
    border: 1px solid #d2e2ef;
    border-radius: 6px;
    background: #ffffff;
    selection-background-color: #d9ebfc;
    selection-color: #184d7e;
}
QTextEdit#taskLog {
    background: #f5faff;
    padding: 10px;
}
QTableWidget {
    gridline-color: #e5eef6;
    alternate-background-color: #f5faff;
}
QHeaderView::section {
    background: #eaf3fc;
    border: none;
    border-bottom: 1px solid #d2e2ef;
    padding: 8px;
    color: #4d6983;
}
QTableWidget::item { padding: 6px; }
QScrollBar:vertical { background: #edf5fc; width: 10px; }
QScrollBar::handle:vertical { background: #adcbe4; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip {
    background: #254865;
    color: #ffffff;
    border: none;
    padding: 6px;
}
